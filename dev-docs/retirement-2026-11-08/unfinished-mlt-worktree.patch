+/* A retained mix can have shorter active bounds while keeping the original
+ * source animation. Relative offsets keep that phase intact when it is moved.
+ * Ordinary transitions and malformed optional metadata use the native path. */
+static int transition_get_progress_map(mlt_transition self, int64_t *offset, int64_t *length)
+{
+    mlt_properties properties = MLT_TRANSITION_PROPERTIES(self);
+    const char *offset_text = mlt_properties_get(properties, "kdenlive:mix_progress_offset");
+    const char *length_text = mlt_properties_get(properties, "kdenlive:mix_progress_length");
+    if (!offset_text || !length_text)
+        return 0;
+    char *end = NULL;
+    errno = 0;
+    *offset = strtoll(offset_text, &end, 10);
+    if (errno || end == offset_text || *end || *offset < 0 || *offset > INT_MAX)
+        return 0;
+    errno = 0;
+    *length = strtoll(length_text, &end, 10);
+    if (errno || end == length_text || *end || *length <= 0 || *length > INT_MAX)
+        return 0;
+    int64_t in = mlt_transition_get_in(self), out = mlt_transition_get_out(self);
+    return in >= 0 && out >= in && *offset < *length && out - in + 1 <= *length - *offset;
+}
+
 /** Get the percent complete.
  *
  * \public \memberof mlt_transition_s
@@ -250,6 +275,12 @@ mlt_position mlt_transition_get_position(mlt_transition self, mlt_frame frame)
 
 double mlt_transition_get_progress(mlt_transition self, mlt_frame frame)
 {
+    int64_t offset, length;
+    if (transition_get_progress_map(self, &offset, &length))
+        return length == 1 ? 0.5
+                           : (offset + (int64_t) mlt_frame_get_position(frame)
+                              - mlt_transition_get_in(self))
+                                 / (double) length;
     double progress = 0;
     mlt_position in = mlt_transition_get_in(self);
     mlt_position out = mlt_transition_get_out(self);
@@ -284,6 +315,9 @@ double mlt_transition_get_progress(mlt_transition self, mlt_frame frame)
 
 double mlt_transition_get_progress_delta(mlt_transition self, mlt_frame frame)
 {
+    int64_t offset, length;
+    if (transition_get_progress_map(self, &offset, &length))
+        return 0.5 / (double) length;
     double progress = 0;
     mlt_position in = mlt_transition_get_in(self);
     mlt_position out = mlt_transition_get_out(self);
