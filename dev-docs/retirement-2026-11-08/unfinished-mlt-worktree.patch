+    void BulkEntryInfoEnumeratesMoreThan512Entries()
+    {
+        Playlist pl(profile);
+        Producer p(profile, "color", "red");
+        QVERIFY(p.is_valid());
+        p.set("length", 100);
+        p.set_in_and_out(0, 99);
+        constexpr int count = 1025;
+        qint64 expectedDuration = 0;
+        // A direct native fixture, with setup outside the getter under test.
+        for (int i = 0; i < count; ++i) {
+            if (i % 3 == 0)
+                QCOMPARE(pl.blank(2), 0);
+            else
+                QCOMPARE(pl.append(p, i % 17, i % 17 + 4), 0);
+            if (i % 23 == 0)
+                QCOMPARE(pl.repeat(i, 2), 0);
+            expectedDuration += (i % 3 == 0 ? 3 : 5) * (i % 23 == 0 ? 2 : 1);
+        }
+        std::array<mlt_playlist_entry_info, 256> entries{};
+        qint64 start = 0;
+        int seen = 0;
+        int batches = 0;
+        while (seen < count) {
+            const int rows = std::min(int(entries.size()), count - seen);
+            QCOMPARE(mlt_playlist_get_entries_info(pl.get_playlist(), seen, rows, entries.data()),
+                     0);
+            ++batches;
+            for (int j = 0; j < rows; ++j) {
+                const int i = seen + j;
+                const auto &entry = entries[j];
+                QCOMPARE(entry.frame_in, mlt_position(i % 3 == 0 ? 0 : i % 17));
+                QCOMPARE(entry.frame_count,
+                         mlt_position((i % 3 == 0 ? 3 : 5) * (i % 23 == 0 ? 2 : 1)));
+                QCOMPARE(entry.repeat, i % 23 == 0 ? 2 : 1);
+                if (i == 0 || i == 512 || i == count - 1) {
+                    mlt_playlist_clip_info legacy;
+                    QCOMPARE(mlt_playlist_get_clip_info(pl.get_playlist(), &legacy, i), 0);
+                    QCOMPARE(start, qint64(legacy.start));
+                    QCOMPARE(entry.cut, legacy.cut);
+                    QCOMPARE(entry.producer, legacy.producer);
+                }
+                QVERIFY(entry.frame_count >= 0);
+                QVERIFY(qint64(entry.frame_count) <= std::numeric_limits<qint64>::max() - start);
+                start += qint64(entry.frame_count);
+            }
+            seen += rows;
+        }
+        QCOMPARE(seen, count);
+        QCOMPARE(batches, 5);
+        QCOMPARE(start, expectedDuration);
+        QCOMPARE(start, qint64(pl.get_playtime()));
+    }
