+                            if (difference) {
+                                ++changed;
+                                if (firstByte < 0) firstByte = byte;
+                                maximum = qMax(maximum, difference);
+                            }
+                        }
+                        qWarning() << "Reload mismatch" << progressive << wipe << position << changed << firstByte << maximum;
+                        qWarning() << "Original XML" << originalXml;
