+#define MLT_PLAYLIST_ENTRY_INFO_API 1
+
+/** \brief Cached playlist entry information without a playlist-relative start.
+ *
+ * The producer and cut pointers are borrowed. Do not close them. They remain
+ * valid only while the playlist entry and referenced producers remain alive
+ * and unchanged. Use the application's normal synchronization to prevent
+ * concurrent playlist edits, autoclose, and producer destruction.
+ *
+ * The cached frame_count includes repeat. Sum it in a suitably wide checked
+ * local accumulator when playlist-relative starts are needed.
+ */
+typedef struct
+{
+    mlt_producer
+        producer;     /**< the producer, or parent producer of a cut; can be NULL after autoclose */
+    mlt_producer cut; /**< the entry's cut producer; can be NULL after autoclose */
+    mlt_position frame_in;    /**< the cached in point */
+    mlt_position frame_out;   /**< the cached out point */
+    mlt_position frame_count; /**< the cached duration including repeats */
+    int repeat;               /**< the cached number of repetitions */
+} mlt_playlist_entry_info;
+
 /** Playlist Entry
 */
 
