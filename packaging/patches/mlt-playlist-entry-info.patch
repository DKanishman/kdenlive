+/** Read a range of cached playlist entries without calculating prefix starts.
+ *
+ * This performs work linear in count, not in first. It allocates no output
+ * buffers or containers, changes no reference counts, and performs no seek,
+ * frame retrieval, refresh or event operation. Parent-producer lookup uses the
+ * existing mlt_producer_cut_parent() semantics; its existing property getters
+ * can canonicalize malformed internal property values.
+ *
+ * This does not refresh cached points from edited cuts. It returns the same
+ * cached points and repeat values used by mlt_playlist_get_clip_info(). Entries
+ * whose producer has been closed by autoclose still return their cached timing
+ * and repeat values with NULL producer and cut pointers.
+ *
+ * The caller must provide room for count records and use its normal native
+ * synchronization to prevent concurrent edits, autoclose or destruction. The
+ * function does not acquire a playlist container lock or retain any producer.
+ *
+ * \public \memberof mlt_playlist_s
+ * \param self a non-NULL playlist
+ * \param first the first entry index, in the inclusive range 0..playlist count
+ * \param count the number of entries, in the range 0..playlist count-first
+ * \param[out] entries caller-owned output array; may be NULL only when count is 0
+ * \return 0 on success, or 1 for an invalid argument or unavailable entry;
+ * all output records are left untouched on error
+ */
+
+int mlt_playlist_get_entries_info(mlt_playlist self,
+                                  int first,
+                                  int count,
+                                  mlt_playlist_entry_info *entries)
+{
+    if (!self || first < 0 || count < 0 || first > self->count || count > self->count - first
+        || (count > 0 && (!entries || !self->list)))
+        return 1;
+
+    // Validate the entire range before writing the caller's first record.
+    for (int i = 0; i < count; ++i)
+        if (!self->list[first + i])
+            return 1;
+
+    for (int i = 0; i < count; ++i) {
+        const playlist_entry *entry = self->list[first + i];
+        mlt_playlist_entry_info *info = &entries[i];
+        info->producer = mlt_producer_cut_parent(entry->producer);
+        info->cut = entry->producer;
+        info->frame_in = entry->frame_in;
+        info->frame_out = entry->frame_out;
+        info->frame_count = entry->frame_count;
+        info->repeat = entry->repeat;
+    }
+    return 0;
 }
 
