diff --git a/src/tests/test_rotoscoping/test_rotoscoping.c b/src/tests/test_rotoscoping/test_rotoscoping.c
new file mode 100644
index 00000000..c81641ab
--- /dev/null
+++ b/src/tests/test_rotoscoping/test_rotoscoping.c
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Private-geometry and native-frame regressions for the rotoscoping filter. */
+#include <float.h>
+#include <stdio.h>
+
+#include "../../modules/plusgpl/filter_rotoscoping.c"
+
+#define CHECK(condition) \
+    do { \
+        if (!(condition)) { \
+            fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #condition); \
+            return 1; \
+        } \
+    } while (0)
+
+static int many_intersections(void)
+{
+    enum { count = 4096, width = 4096, height = 3 };
+    PointF *polygon = malloc(count * sizeof(PointF));
+    uint8_t *map = malloc(width * height);
+    CHECK(polygon && map);
+    for (int i = 0; i < count; i++)
+        polygon[i] = (PointF){i, i % 2 ? 2 : 0};
+    for (int invert = 0; invert < 2; invert++) {
+        CHECK(fillMap(polygon, count, width, height, invert, map) == 0);
+        // Independent even/odd oracle, preserving native integer-edge rules.
+        for (int x = 0; x < width; x++) {
+            int inside = invert;
+            for (int i = 0, j = count - 1; i < count; j = i++) {
+                if ((polygon[i].y > 1) != (polygon[j].y > 1)) {
+                    double edge = polygon[i].x
+                                  + (1 - polygon[i].y) / (polygon[j].y - polygon[i].y)
+                                        * (polygon[j].x - polygon[i].x);
+                    if ((int) edge <= x)
+                        inside = !inside;
+                }
+            }
+            CHECK(map[width + x] == inside * 255);
+        }
+    }
+    free(map);
+    free(polygon);
+    return 0;
+}
+
+static int loop_and_bounds(void)
+{
+    BPointF loop = {{16, 16}, {64, 96}, {112, 16}};
+    PointF *points = NULL;
+    int count = 0, capacity = 0;
+    uint8_t map[128 * 128];
+    CHECK(curvePoints(loop, loop, &points, &count, &capacity) == 0);
+    CHECK(count > 32 && count < ROTO_MAX_VERTICES);
+    CHECK(fillMap(points, count, 128, 128, 0, map) == 0);
+    CHECK(map[60 * 128 + 64] == 255);
+    CHECK(map[110 * 128 + 64] == 0);
+    free(points);
+
+    points = NULL;
+    count = capacity = 0;
+    BPointF huge = {{0, 0}, {0, 0}, {DBL_MAX / 4, DBL_MAX / 4}};
+    CHECK(curvePoints(huge, huge, &points, &count, &capacity) != 0);
+    CHECK(count == 0);
+    free(points);
+
+    points = NULL;
+    count = capacity = 0;
+    huge.h2.x = NAN;
+    CHECK(curvePoints(huge, huge, &points, &count, &capacity) != 0);
+    CHECK(points == NULL && count == 0);
+    count = capacity = ROTO_MAX_VERTICES;
+    CHECK(appendPoint((PointF){0, 0}, &points, &count, &capacity) != 0);
+    CHECK(points == NULL && count == ROTO_MAX_VERTICES);
+    CHECK(fillMap(NULL, 0, INT_MAX, 2, 0, map) != 0);
+    PointF offscreen[] = {{-DBL_MAX / 4, 0}, {DBL_MAX / 4, 0},
+                          {DBL_MAX / 4, 128}, {-DBL_MAX / 4, 128}};
+    CHECK(fillMap(offscreen, 4, 128, 128, 0, map) == 0);
+    CHECK(map[64 * 128 + 64] == 255);
+    return 0;
+}
+
+static int native_frame(void)
+{
+    // Exercise the production callback, including error propagation before
+    // rasterization. No installed plugin, provider or external media is needed.
+    mlt_profile profile = mlt_profile_init(NULL);
+    CHECK(profile);
+    profile->width = profile->height = 128;
+    profile->sample_aspect_num = profile->sample_aspect_den = 1;
+    mlt_filter filter = filter_rotoscoping_init(profile, mlt_service_filter_type, "rotoscoping", NULL);
+    CHECK(filter);
+    mlt_service_set_profile(MLT_FILTER_SERVICE(filter), profile);
+    mlt_properties_set(MLT_FILTER_PROPERTIES(filter), "spline",
+                       "[[[0.125,0.125],[0.5,0.75],[0.875,0.125]]]");
+    mlt_frame frame = mlt_frame_init(NULL);
+    CHECK(frame);
+    uint8_t *pixels = mlt_pool_alloc(128 * 128 * 4);
+    CHECK(pixels);
+    memset(pixels, 255, 128 * 128 * 4);
+    mlt_frame_set_image(frame, pixels, 128 * 128 * 4, mlt_pool_release);
+    mlt_properties properties = MLT_FRAME_PROPERTIES(frame);
+    mlt_properties_set_int(properties, "width", 128);
+    mlt_properties_set_int(properties, "height", 128);
+    mlt_properties_set_int(properties, "format", mlt_image_rgba);
+    mlt_frame_set_aspect_ratio(frame, 1);
+    filter_process(filter, frame);
+    mlt_image_format format = mlt_image_rgba;
+    int width = 128, height = 128;
+    CHECK(mlt_frame_get_image(frame, &pixels, &format, &width, &height, 1) == 0);
+    CHECK(format == mlt_image_rgba && width == 128 && height == 128);
+    CHECK(pixels[(60 * 128 + 64) * 4 + 3] == 255);
+    CHECK(pixels[(110 * 128 + 64) * 4 + 3] == 0);
+    mlt_frame_close(frame);
+
+    mlt_properties_set(MLT_FILTER_PROPERTIES(filter), "spline",
+                       "[[[0,0],[0,0],[1e100,1e100]]]");
+    frame = mlt_frame_init(NULL);
+    CHECK(frame);
+    pixels = mlt_pool_alloc(128 * 128 * 4);
+    CHECK(pixels);
+    memset(pixels, 255, 128 * 128 * 4);
+    mlt_frame_set_image(frame, pixels, 128 * 128 * 4, mlt_pool_release);
+    properties = MLT_FRAME_PROPERTIES(frame);
+    mlt_properties_set_int(properties, "width", 128);
+    mlt_properties_set_int(properties, "height", 128);
+    mlt_properties_set_int(properties, "format", mlt_image_rgba);
+    mlt_frame_set_aspect_ratio(frame, 1);
+    filter_process(filter, frame);
+    format = mlt_image_rgba;
+    width = height = 128;
+    // The public frame API replaces failed callbacks with a test image.
+    // Invoke the registered production callback to observe its own error and
+    // verify that it did not partially modify the original frame buffer.
+    mlt_get_image callback = mlt_frame_pop_get_image(frame);
+    CHECK(callback);
+    CHECK(callback(frame, &pixels, &format, &width, &height, 1) != 0);
+    // No partial alpha mask is applied when geometry exceeds its depth budget.
+    CHECK(pixels[(60 * 128 + 64) * 4 + 3] == 255);
+    mlt_frame_close(frame);
+    mlt_filter_close(filter);
+    mlt_profile_close(profile);
+    return 0;
+}
+
+int main(void)
+{
+    mlt_pool_init();
+    int error = many_intersections() || loop_and_bounds() || native_frame();
+    mlt_pool_close();
+    return error;
+}
